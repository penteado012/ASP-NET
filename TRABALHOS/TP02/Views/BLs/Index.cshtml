@model IEnumerable<SistemaBLContainer.Models.BL>

@{
    ViewData["Title"] = "BLs";
}

<h1>Lista de BLs</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    Novo BL
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Número</th>
            <th>Consignee</th>
            <th>Navio</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var bl in Model)
        {
            <tr>
                <td>@bl.Id</td>
                <td>@bl.Numero</td>
                <td>@bl.Consignee</td>
                <td>@bl.Navio</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@bl.Id"
                       class="btn btn-info btn-sm">
                        Detalhes
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@bl.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@bl.Id"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>