@model TP04.Dominio.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<h1>Excluir Produto</h1>
<h3>Tem certeza de que deseja excluir isto?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nome)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Preco)</dt>
        <dd class="col-sm-10">@Model.Preco.ToString("C")</dd>

        <dt class="col-sm-2">Quantidade</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.QuantidadeEstoque)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" />
        <a class="btn btn-secondary ms-2" asp-action="Index">Cancelar</a>
    </form>
</div>